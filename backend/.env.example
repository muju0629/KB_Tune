# 언어 생성 방식. 기본 offline → 유료 API를 절대 호출하지 않음(비용 0).
#   offline : 엔진 + 템플릿 (키 불필요)
#   local   : 로컬 오픈소스 모델(OpenAI 호환: Bonsai / Ollama / llama.cpp) — 비용 0
#   claude  : Anthropic API (유료) — 명시적으로 켤 때만
LLM_BACKEND=offline

# --- local 모드용 (OpenAI 호환 로컬 서버) ---
# Bonsai(llama-server): http://localhost:8080/v1  ·  Ollama: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=bonsai

# --- claude 모드용 (선택, 유료) ---
ANTHROPIC_API_KEY=
KB_TUNE_MODEL=claude-opus-4-8
