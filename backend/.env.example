# 언어 생성 방식. 기본 offline → 유료 API를 절대 호출하지 않음(비용 0).
#   offline : 엔진 + 템플릿 (키 불필요)
#   local   : 로컬 오픈소스 모델(OpenAI 호환: Bonsai / Ollama / llama.cpp) — 비용 0
#   claude  : Anthropic API (유료) — 명시적으로 켤 때만
LLM_BACKEND=offline

# --- local 모드용 (OpenAI 호환 로컬 서버) ---
# Bonsai(llama-server): http://localhost:8080/v1  ·  Ollama: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=bonsai

# --- claude 모드용 (선택, 유료) ---
ANTHROPIC_API_KEY=
KB_TUNE_MODEL=claude-opus-5

# --- 보안 ---
# 요청 인증 키. 비우면 무인증(로컬 개발용). 공개된 곳에 배포하면 반드시 채운다.
KB_TUNE_API_KEY=
# 프록시(Render 등) 뒤에 둘 때만 1. X-Forwarded-For 를 클라이언트 IP로 믿는다.
KB_TUNE_TRUST_PROXY=
# 브라우저에서 부를 때만 채운다. 네이티브 앱만 쓰면 비워둔다(=CORS 전면 차단).
KB_TUNE_ALLOWED_ORIGINS=
# LLM 엔드포인트가 https/루프백이 아니어도 허용(LAN의 로컬 모델 서버용). 기본 차단.
KB_TUNE_ALLOW_INSECURE_LLM_URL=
# 본문 상한(bytes). 기본 2,000,000 — base64 이미지 한 장 크기.
KB_TUNE_MAX_BODY_BYTES=
# 속도 제한. LLM=클라이언트당 분당, LLM_GLOBAL=전체 합 분당(API 비용의 실질 상한),
# EVAL=클라이언트당 5분당, CHEAP=엔진 전용 엔드포인트 분당.
KB_TUNE_RATE_LLM=
KB_TUNE_RATE_LLM_GLOBAL=
KB_TUNE_RATE_EVAL=
KB_TUNE_RATE_CHEAP=
